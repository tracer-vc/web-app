# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: service-role/secret key for background pipeline workers. Bypasses RLS.
SUPABASE_SECRET_KEY=

# LLM (OpenAI). Model defaults to gpt-6-luna; per-fund override in funds.llm_model.
OPENAI_API_KEY=

# Web search (Step 2b)
TAVILY_API_KEY=

# Background jobs (Inngest on Vercel). Not needed locally with the Inngest dev server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

