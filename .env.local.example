# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: service-role/secret key for background pipeline workers. Bypasses RLS.
SUPABASE_SECRET_KEY=

# LLM (OpenAI). Model defaults to gpt-6-luna; per-fund override in funds.llm_model.
OPENAI_API_KEY=

# Web search (Step 2b)
TAVILY_API_KEY=

# Background jobs (Inngest). Locally: INNGEST_DEV=1 and run `npx inngest-cli@latest dev`
# next to the app; no keys needed. On Vercel: leave INNGEST_DEV unset and set both keys
# from Inngest Cloud (see docs/open-todos.md).
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

